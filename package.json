{
  "name": "mcpgeneration-for-elevenlabs",
  "version": "0.1.0",
  "private": true,
  "description": "A local, cost-controlled MCP server for ElevenLabs media APIs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-openapi.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doctor": "tsx src/doctor.ts",
    "smoke:real": "tsx src/smoke-real.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.75.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "music-metadata": "12.3.4",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
