ELEVENLABS_API_KEY=
MCP_TRANSPORT=stdio
LOG_LEVEL=info
GENERATED_DIR=./generated
DATABASE_PATH=./data/mcp.sqlite
ALLOWED_ROOTS=
DRY_RUN=true
ALLOW_PAID_GENERATIONS=false
MAX_CREDITS_PER_REQUEST=500
MAX_MONTHLY_CREDITS=5000
MAX_CONCURRENT_GENERATIONS=1
ENABLE_IMAGE_API=false
ENABLE_VIDEO_API=false
ENABLE_MUSIC_FINETUNES=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
REQUEST_TIMEOUT_MS=120000
MAX_MEDIA_BYTES=104857600
